---
import Site from "../../layouts/Site.astro";
import HomeA from "../../components/a/Home.astro";
import HomeB from "../../components/b/Home.astro";
import { perVariant } from "../../lib/page";
import type { V } from "../../lib/site";
export function getStaticPaths() {
  return perVariant();
}
const { v } = Astro.props as { v: V };
---
<Site v={v} wide title="Реверс-редуктор: судовые реверс-редукторы РР-300, РР-238, 3Д6, 3Д12 от ООО «Дело»"
  description={`Изготовление, ремонт и запасные части судовых реверс-редукторов РР-300, РР-238, 3Д6, 3Д12. Каталог РР-300 по заводским чертежам, свидетельство РКО № 06552. Дизайн ${v.toUpperCase()}.`}>
  {v === "a" ? <HomeA /> : <HomeB />}
</Site>
