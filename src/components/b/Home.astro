---
// B · «Каталожный терминал»: the home page is a working parts console. Search with live results, the request list
// beside it, then the wall of all 26 factory drawings, then the equipment register.
import Icon from "../shared/Icon.astro";
import { models, rr300, nodes, services, entries, modelById, frontView, unitPhoto, scans } from "../../lib/domain";
import { COMPANY, CERT, MANUAL, link, root } from "../../lib/site";
const L = (p = "") => link("b", p);
const val = (m: typeof rr300, l: string) => m.key.find((k) => k.label === l)?.value ?? "–";
// compact index for the live search: [key, designation, name, model id, model name, first place text, first place href, spellings]
const index = entries.map((e) => {
  const u = e.uses[0];
  return [e.key, e.designation, e.name, e.model, modelById.get(e.model)!.name,
    u ? `рис. ${u.figure}${u.pos != null ? `, поз. ${u.pos}` : ""}` : "", u ? `zapchasti/rr-300/${u.slug}/#poz-${u.pos}` : "", e.spellings.join("|"), e.uses.length];
});
const EX = ["525-16-110", "СБ525-12-104", "подшипник 313", "шестерня"];
---
<section class="b-console" aria-labelledby="b-h1"><div class="wrap b-console-grid">
  <div class="b-console-main" data-live data-base={L()}>
    <p class="b-label">Реверс-редукторы РР-300 · РР-238 · 3Д6 · 3Д12 · муфты сцепления</p>
    <h1 id="b-h1">Запасные части и оборудование по заводским обозначениям</h1>
    <form class="b-search" role="search" action={L("zapchasti/")} method="get">
      <label for="b-q">Обозначение, наименование или узел</label>
      <div class="b-search-row">
        <input id="b-q" name="q" type="search" placeholder="Например, 525-16-110" autocomplete="off" spellcheck="false" enterkeyhint="search" aria-describedby="b-live-count" aria-controls="b-live">
        <button class="btn" type="submit"><Icon name="search" size={18} />Найти</button>
      </div>
    </form>
    <div class="b-live" id="b-live">
      <p class="b-live-count" id="b-live-count" aria-live="polite" data-live-count>{entries.length} позиций: {models.map((m) => `${m.name} ${entries.filter((e) => e.model === m.id).length}`).join(" · ")}</p>
      <ol class="b-live-list" data-live-list hidden></ol>
      <p class="b-ex" data-live-ex>Например: {EX.map((e, i) => <>{i > 0 && " · "}<a href={L(`zapchasti/?q=${encodeURIComponent(e)}`)} data-live-try={e}>{e}</a></>)}</p>
      <p class="b-live-all" data-live-all hidden><a href={L("zapchasti/")}>Все результаты в перечне<Icon name="arrow-right" size={16} /></a></p>
    </div>
    <ul class="b-routes">
      <li><a href={L("zapchasti/rr-300/")}><span class="b-no">РР-300</span>{nodes.length} узлов по чертежам</a></li>
      {models.filter((m) => !m.hasNodeCatalog).map((m) => <li><a href={L(`zapchasti/${m.slug}/`)}><span class="b-no">{m.name}</span>перечень, {entries.filter((e) => e.model === m.id).length} поз.</a></li>)}
    </ul>
    <script type="application/json" id="parts-index" set:html={JSON.stringify(index)} />
  </div>
  <aside class="b-side" aria-label="Список запроса и документы">
    <section class="b-panel b-rfq-panel" aria-labelledby="b-rfq-h" data-rfq-panel>
      <h2 id="b-rfq-h">Список запроса</h2>
      <p class="b-panel-empty" data-rfq-panel-empty>Пусто. Добавляйте позиции кнопкой «В запрос»: обозначение, исполнение и количество попадут в письмо.</p>
      <ol class="b-panel-list" data-rfq-panel-list hidden></ol>
      <p><a class="btn ghost sm" href={L("zapros/")}>Открыть список</a></p>
    </section>
    <section class="b-panel b-cert-mini" aria-labelledby="b-cert-h">
      <img src={root(CERT.img.t.src)} width={CERT.img.t.w} height={CERT.img.t.h} alt={`Миниатюра свидетельства о признании РКО № ${CERT.no}`} loading="lazy" />
      <div>
        <h2 id="b-cert-h">Свидетельство РКО <span class="nw">№ {CERT.no}</span></h2>
        <p class="b-mono">{CERT.from} – {CERT.to}</p>
        <p class="b-links"><a href={root(CERT.pdf)} target="_blank" rel="noopener">PDF, {CERT.pdfKb} КБ</a><a href={L("dokumentaciya/#rko")}>Область признания</a></p>
      </div>
    </section>
    <section class="b-panel" aria-labelledby="b-con-h">
      <h2 id="b-con-h">{COMPANY.operator}</h2>
      <p><a class="b-big" href={`tel:${COMPANY.tel}`}>{COMPANY.phone}</a><br><a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a></p>
      <p class="b-links"><a href={L("zakupki/")}>Документы для закупки</a><a href={L("kontakty/#rekvizity")}>Реквизиты</a></p>
    </section>
  </aside>
</div></section>

<section class="b-wall" aria-labelledby="b-wall-h"><div class="wrap">
  <header class="b-sec-head"><p class="b-idx">Каталог деталей и сборочных единиц РР-300</p><h2 id="b-wall-h">{nodes.length} узлов по заводским чертежам</h2><a class="textlink" href={L("zapchasti/rr-300/")}>Список узлов<Icon name="arrow-right" size={16} /></a></header>
  <ol class="b-wall-grid">
    {nodes.map((n) => (
      <li><a href={L(`zapchasti/rr-300/${n.slug}/`)} data-keep-isp>
        <span class="b-wall-img"><img src={root(n.drawing.t.src)} width={n.drawing.t.w} height={n.drawing.t.h} alt="" loading="lazy" decoding="async" /></span>
        <span class="b-wall-cap"><span class="b-no">{String(n.figure).padStart(2, "0")}</span><span class="b-wall-t">{n.title}</span></span>
      </a></li>
    ))}
    <li class="b-wall-more"><a href={L("dokumentaciya/katalog-rr-300/")}><span class="b-idx">Каталог целиком</span><span class="b-wall-more-t">{scans.length} страниц заводского каталога РР-300 в исходном виде</span><span class="textlink">Открыть сканы<Icon name="arrow-right" size={16} /></span></a></li>
  </ol>
</div></section>

<section class="b-equip" aria-labelledby="b-eq-h"><div class="wrap b-equip-grid">
  <figure class="b-frame b-front">
    <p class="b-frame-top"><span>РР-300</span><span class="sku">{rr300.designation}</span></p>
    <img src={root(frontView.t.src)} srcset={`${root(frontView.t.src)} 1200w, ${root(frontView.f.src)} 2400w`} sizes="(min-width: 1000px) 30vw, 90vw" width={frontView.t.w} height={frontView.t.h} alt="Чертёж РР-300, вид со стороны фланца выходного вала (руководство по эксплуатации, рисунок 2)" loading="lazy" />
    <figcaption class="b-frame-cap">Вид со стороны фланца выходного вала. РР-300.РЭ, рис. 2</figcaption>
  </figure>
  <div>
    <header class="b-sec-head"><p class="b-idx">Наша продукция</p><h2 id="b-eq-h">Реестр оборудования</h2><a class="textlink" href={L("produkciya/")}>Все характеристики<Icon name="arrow-right" size={16} /></a></header>
    <div class="tbl-wrap" tabindex="0" role="region" aria-label="Модели реверс-редукторов">
      <table class="tbl b-models">
        <thead><tr><th scope="col">Модель</th><th scope="col">Обозначение</th><th scope="col">Тип</th><th scope="col">Мощность</th><th scope="col">Передний ход</th><th scope="col">Масса</th></tr></thead>
        <tbody>{models.map((m) => (
          <tr><th scope="row"><a href={L(`produkciya/${m.slug}/`)}>{m.name}</a></th><td><span class="sku">{m.designation}</span></td><td>{m.kind}</td><td class="nw">{val(m, "Мощность")}</td><td class="nw">{val(m, "Передний ход")}</td><td class="nw">{val(m, "Масса")}</td></tr>
        ))}</tbody>
      </table>
    </div>
    <div class="b-unit">
      <img src={root(unitPhoto.t.src)} srcset={`${root(unitPhoto.t.src)} 480w, ${root(unitPhoto.f.src)} 780w`} sizes="(min-width: 1000px) 240px, 45vw" width={unitPhoto.t.w} height={unitPhoto.t.h} alt={unitPhoto.alt} loading="lazy" />
      <div>
        <p class="b-unit-h"><a href={L("produkciya/rr-300/")}>{rr300.name}</a>: {rr300.variants.length} заводских исполнений</p>
        <p>{rr300.text[0]}</p>
        <p class="b-links"><a href={L("produkciya/rr-300/#ispolneniya")}>Таблица исполнений</a><a href={root(MANUAL.href)} target="_blank" rel="noopener">Руководство РР-300.РЭ, PDF</a></p>
      </div>
    </div>
  </div>
</div></section>

<section class="b-tail"><div class="wrap b-tail-grid">
  <section aria-labelledby="b-svc-h">
    <header class="b-sec-head"><p class="b-idx">ООО «Дело»</p><h2 id="b-svc-h">Услуги</h2></header>
    <dl class="b-svc">{services.map((s) => <div><dt><a href={L(`uslugi/#${s.id}`)}>{s.title}</a>{s.rko && <span class="b-tag">РКО</span>}</dt><dd>{s.text[0]}</dd></div>)}</dl>
  </section>
  <section aria-labelledby="b-doc-h">
    <header class="b-sec-head"><p class="b-idx">Документы</p><h2 id="b-doc-h">Документация и закупки</h2></header>
    <ul class="b-docs">
      <li><a href={root(CERT.pdf)} target="_blank" rel="noopener"><Icon name="file-type-pdf" size={18} />Свидетельство о признании РКО № {CERT.no}</a><span>PDF · {CERT.pdfKb} КБ</span></li>
      <li><a href={root(MANUAL.href)} target="_blank" rel="noopener"><Icon name="file-type-pdf" size={18} />Руководство по эксплуатации РР-300</a><span>PDF · {MANUAL.pages} с.</span></li>
      <li><a href={L("dokumentaciya/katalog-rr-300/")}><Icon name="file-text" size={18} />Каталог деталей РР-300, сканы</a><span>{scans.length} с.</span></li>
      <li><a href={root("rekvizity.txt")} download="rekvizity-ooo-delo.txt"><Icon name="file-download" size={18} />Карточка предприятия</a><span>TXT</span></li>
      <li><a href={L("zakupki/")}><Icon name="file-text" size={18} />Порядок участия в закупках</a><span>страница</span></li>
    </ul>
  </section>
</div></section>
