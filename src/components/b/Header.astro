---
// B: a one-line command bar like an engineering application. Short section names, request list always visible.
import Icon from "../shared/Icon.astro";
import { COMPANY, CERT, link } from "../../lib/site";
const { section } = Astro.props as { section: string };
const L = (p = "") => link("b", p);
const NAV: [string, string][] = [["produkciya/", "Продукция"], ["zapchasti/", "Запчасти"], ["uslugi/", "Услуги"], ["dokumentaciya/", "Документация"], ["zakupki/", "Закупки"], ["kontakty/", "Контакты"]];
---
<header class="b-header">
  <div class="b-bar">
    <a class="b-brand" href={L()}><span class="b-mark" aria-hidden="true"></span><span><b>{COMPANY.brand}</b><small>{COMPANY.operator} · {COMPANY.tagline.toLowerCase()}</small></span></a>
    <nav class="b-nav" id="nav" aria-label="Основное меню">
      <ul>{NAV.map(([p, n]) => <li><a href={L(p)} aria-current={section === p ? "page" : undefined}>{n}</a></li>)}</ul>
      <p class="b-nav-contact"><a href={`tel:${COMPANY.tel}`}>{COMPANY.phone}</a><a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a><a href={L("dokumentaciya/#rko")}>РКО № {CERT.no}</a></p>
    </nav>
    <a class="b-tel" href={`tel:${COMPANY.tel}`}><Icon name="phone" size={16} />{COMPANY.phone}</a>
    <a class="b-rfq" href={L("zapros/")} data-rfq-count-wrap aria-current={section === "zapros/" ? "page" : undefined}>
      <Icon name="clipboard-list" size={18} /><span class="lbl">Запрос</span><span class="cnt" data-rfq-count>0</span><span class="sr"> позиций в списке запроса</span>
    </a>
    <button class="menu-btn" type="button" aria-controls="nav" aria-expanded="false" data-menu><Icon name="menu-2" size={22} /><span>Меню</span></button>
  </div>
</header>
