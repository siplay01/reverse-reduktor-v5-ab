---
import { COMPANY, CERT, link, root } from "../../lib/site";
const L = (p = "") => link("a", p);
---
<footer class="a-footer">
  <div class="a-f-grid">
    <p class="a-f-name">{COMPANY.full}</p>
    <dl class="a-f-req">
      <div><dt>ИНН</dt><dd>{COMPANY.inn}</dd></div><div><dt>КПП</dt><dd>{COMPANY.kpp}</dd></div><div><dt>ОГРН</dt><dd>{COMPANY.ogrn}</dd></div>
      <div><dt>Адрес</dt><dd>{COMPANY.address}</dd></div>
    </dl>
    <p class="a-f-links"><a href={L("kontakty/#rekvizity")}>Полные реквизиты</a><a href={L("dokumentaciya/#rko")}>Свидетельство РКО № {CERT.no}</a><a href={L("konfidencialnost/")}>Персональные данные</a><a href={root()}>Дизайны A и B</a></p>
  </div>
</footer>
